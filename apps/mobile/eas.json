{
  "cli": {
    "version": ">= 7.5.0",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "development",
        "EAS_SKIP_AUTO_FINGERPRINT": "1"
      },
      "autoIncrement": false
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EAS_SKIP_AUTO_FINGERPRINT": "1",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      },
      "autoIncrement": false
    },
    "production": {
      "env": {
        "EAS_SKIP_AUTO_FINGERPRINT": "1",
        "SENTRY_ALLOW_FAILURE": "true"
      },
      "autoIncrement": false
    }
  },
  "submit": {
    "production": {}
  }
}
